MASTERCLAW_DISCORD_TOKEN=replace-me
MASTERCLAW_OPENROUTER_API_KEY=replace-me
MASTERCLAW_DATABASE_PATH=data/masterclaw.sqlite3
MASTERCLAW_PROMPT_PATH=prompts
MASTERCLAW_DISCORD_DEBOUNCE_SECONDS=1.5
MASTERCLAW_LLM_MAX_CONCURRENCY=4
# Optional semantic classifier: off (default) or shadow. Never changes authoritative decisions.
# Jev reuses MASTERCLAW_OPENROUTER_API_KEY. Optional dedicated override:
# MASTERCLAW_CLASSIFIER_API_KEY=replace-me
# State dispatch sends only the fresh message and bounded scenario/pending/workspace labels.
# It adds bounded latency; history, player identifiers and GM context are excluded.
MASTERCLAW_CLASSIFIER__MODE=off
MASTERCLAW_CLASSIFIER__PROVIDER=jev
MASTERCLAW_CLASSIFIER__MODEL=~typesafe/jev-latest
# Threshold is an evaluation signal only; calibrate on Russian gameplay before activation.
MASTERCLAW_CLASSIFIER__THRESHOLD=0.95
MASTERCLAW_CLASSIFIER__TIMEOUT_SECONDS=5
# Classifier capacity is independent of the generative LLM concurrency setting.
MASTERCLAW_CLASSIFIER__MAX_CONCURRENCY=4
# Per-use-case settings override the legacy flat mode/threshold/timeout for state_dispatch.
# MASTERCLAW_CLASSIFIER__STATE_DISPATCH__MODE=shadow
# MASTERCLAW_CLASSIFIER__STATE_DISPATCH__THRESHOLD=0.95
# MASTERCLAW_CLASSIFIER__STATE_DISPATCH__TIMEOUT_SECONDS=5
# Advancement shadow is separately opt-in and never grants/denies an actual permit.
# It sends public scene title/description/facts, the requested training, and bounded public
# fact changes from this scene; no chat, IDs, XP/levels, hidden context, or legacy GM reason.
MASTERCLAW_CLASSIFIER__ADVANCEMENT__MODE=off
MASTERCLAW_CLASSIFIER__ADVANCEMENT__ALLOW_THRESHOLD=0.95
MASTERCLAW_CLASSIFIER__ADVANCEMENT__DENY_THRESHOLD=0.05
MASTERCLAW_CLASSIFIER__ADVANCEMENT__TIMEOUT_SECONDS=5
# Action remains reserved; it has no application route enabled by this configuration.
MASTERCLAW_CLASSIFIER__ACTION__MODE=off
# Action capability is a separate advisory sidecar; never selects traits/pool/difficulty.
MASTERCLAW_CLASSIFIER__ACTION_CAPABILITY__MODE=off
MASTERCLAW_CLASSIFIER__ACTION_CAPABILITY__CAPABLE_THRESHOLD=0.95
MASTERCLAW_CLASSIFIER__ACTION_CAPABILITY__BLOCKED_THRESHOLD=0.98
MASTERCLAW_CLASSIFIER__ACTION_CAPABILITY__TIMEOUT_SECONDS=5
# Narrator rights: shadow only, legacy assessment and publication prose remain authoritative.
# Sends bounded submitted text/public fiction, resolved success/failure and rights, never raw
# history, IDs, private sheet/GM data, or legacy approved/rejected prose. Adds bounded latency.
MASTERCLAW_CLASSIFIER__PLAYER_NARRATION_RIGHTS__MODE=off
MASTERCLAW_CLASSIFIER__PLAYER_NARRATION_RIGHTS__ALLOW_THRESHOLD=0.95
MASTERCLAW_CLASSIFIER__PLAYER_NARRATION_RIGHTS__DENY_THRESHOLD=0.05
MASTERCLAW_CLASSIFIER__PLAYER_NARRATION_RIGHTS__TIMEOUT_SECONDS=5
MASTERCLAW_STATE_MODEL__MODEL=openrouter/nex-agi/nex-n2-mini
MASTERCLAW_STATE_MODEL__TEMPERATURE=0
MASTERCLAW_STATE_MODEL__MAX_OUTPUT_TOKENS=500
MASTERCLAW_STATE_MODEL__REASONING_EFFORT=low
MASTERCLAW_STATE_MODEL__OUTPUT_TRANSPORT=prompt_json
MASTERCLAW_REASONING_MODEL__MODEL=openrouter/openai/gpt-5.6-luna
MASTERCLAW_REASONING_MODEL__TEMPERATURE=0.2
MASTERCLAW_REASONING_MODEL__MAX_OUTPUT_TOKENS=6000
MASTERCLAW_REASONING_MODEL__REASONING_EFFORT=medium
MASTERCLAW_REASONING_MODEL__OUTPUT_TRANSPORT=prompt_json
MASTERCLAW_REASONING_FALLBACK_MODEL__MODEL=openrouter/google/gemini-3-flash-preview
MASTERCLAW_REASONING_FALLBACK_MODEL__TEMPERATURE=0.2
MASTERCLAW_REASONING_FALLBACK_MODEL__MAX_OUTPUT_TOKENS=6000
MASTERCLAW_REASONING_FALLBACK_MODEL__TIMEOUT_SECONDS=180
MASTERCLAW_REASONING_FALLBACK_MODEL__REASONING_EFFORT=medium
MASTERCLAW_REASONING_FALLBACK_MODEL__OUTPUT_TRANSPORT=prompt_json
MASTERCLAW_NARRATIVE_MODEL__MODEL=openrouter/openai/gpt-5.6-luna
MASTERCLAW_NARRATIVE_MODEL__TEMPERATURE=0.7
MASTERCLAW_NARRATIVE_MODEL__MAX_OUTPUT_TOKENS=1800
MASTERCLAW_NARRATIVE_MODEL__REASONING_EFFORT=low
MASTERCLAW_NARRATIVE_MODEL__OUTPUT_TRANSPORT=native_tool
MASTERCLAW_NARRATIVE_REVIEW_MODEL__MODEL=openrouter/openai/gpt-5.6-luna
MASTERCLAW_NARRATIVE_REVIEW_MODEL__TEMPERATURE=0.2
MASTERCLAW_NARRATIVE_REVIEW_MODEL__MAX_OUTPUT_TOKENS=6000
MASTERCLAW_NARRATIVE_REVIEW_MODEL__TIMEOUT_SECONDS=120
MASTERCLAW_NARRATIVE_REVIEW_MODEL__REASONING_EFFORT=medium
MASTERCLAW_NARRATIVE_REVIEW_MODEL__OUTPUT_TRANSPORT=prompt_json
