MASTERCLAW_NARRATIVE_REVIEW_FALLBACK_MODEL__TIMEOUT_SECONDS=180
MASTERCLAW_NARRATIVE_REVIEW_FALLBACK_MODEL__REASONING_EFFORT=medium
MASTERCLAW_NARRATIVE_REVIEW_FALLBACK_MODEL__OUTPUT_TRANSPORT=prompt_json
